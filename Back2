"""
SFS COMPLETO PARA TU DATASET
================================

Objetivo
--------
Ejecutar seleccion secuencial de variables:
- Forward Selection: agrega variables una a una.
- Backward Selection: elimina variables una a una.

Modelos evaluados
-----------------
1. Regresion Logistica.
2. Random Forest.
3. XGBoost.

Datos esperados
---------------
- DataFrame ya cargado en memoria: dataset
- Variable objetivo binaria: marca (0/1)

Este archivo NO lee automaticamente dataset.csv. Esta pensado para ejecutarse
DESPUES de que ya cargaste tu DataFrame `dataset` en el notebook de VS Code.

Uso desde Notebook
------------------
1. Guarda este archivo en la misma carpeta que el notebook.
2. En una celda del notebook ejecuta:

    %run sfs_completo_dataset_marca.py

3. O, si prefieres importar y ejecutar manualmente:

    from sfs_completo_dataset_marca import ejecutar_sfs_completo
    results = ejecutar_sfs_completo(dataset)

Importante sobre estandarizacion
--------------------------------
La regresion logistica NO se estandariza en este script, como solicitaste.
La estandarizacion no es obligatoria para una regresion logistica: las
probabilidades predichas pueden ser validas sin escalar, siempre que el
algoritmo converja. Sin embargo, si tus variables tienen escalas extremadamente
diferentes y el modelo no converge, puedes activar estandarizacion cambiando
USAR_ESTANDARIZACION_LOGIT = True.

Requisitos
----------
from mlxtend.feature_selection import SequentialFeatureSelector as SFS
"""

from pathlib import Path
from typing import Dict, List, Tuple, Union

import numpy as np
import pandas as pd
import xgboost as xgb

from mlxtend.feature_selection import SequentialFeatureSelector as SFS
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler


# =============================================================================
# 1. CONFIGURACION: EDITA SOLAMENTE ESTA SECCION SI LO NECESITAS
# =============================================================================
TARGET_COL = "marca"

# Agrega aca columnas que NO deben entrar al modelo.
# Por ejemplo IDs, fechas, variables posteriores al evento y leakage.
COLUMNAS_A_EXCLUIR = [
    TARGET_COL,
    # "id_cliente",
    # "id_transaccion",
    # "fecha_logueo",
    # "timestamp",
    # "variable_con_leakage",
]

# False: Regresion Logistica SIN StandardScaler (configuracion solicitada).
# True: Agrega StandardScaler antes de la Regresion Logistica.
USAR_ESTANDARIZACION_LOGIT = False

# Primera corrida recomendada.
# k_features=(5, 20) evalua modelos de 5, 6, ..., 20 variables.
N_FOLDS = 3
K_FEATURES = (5, 20)
N_JOBS = 1
RANDOM_STATE = 42
OUTPUT_DIR = "output_sfs"


# =============================================================================
# 2. FUNCION PARA CREAR LOS MODELOS
# =============================================================================
def crear_modelos(usar_estandarizacion_logit: bool = False) -> Dict[str, dict]:
    """Crea los modelos que se usaran en forward y backward selection."""

    logit_base = LogisticRegression(
        max_iter=2_000,
        solver="liblinear",
        random_state=RANDOM_STATE
    )

    if usar_estandarizacion_logit:
        modelo_logit = Pipeline([
            ("scaler", StandardScaler()),
            ("model", logit_base)
        ])
    else:
        modelo_logit = logit_base

    modelo_rf = RandomForestClassifier(
        n_estimators=300,
        max_depth=None,
        min_samples_leaf=1,
        n_jobs=N_JOBS,
        random_state=RANDOM_STATE
    )

    modelo_xgb = xgb.XGBClassifier(
        n_estimators=300,
        max_depth=5,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        n_jobs=N_JOBS,
        random_state=RANDOM_STATE,
        eval_metric="auc"
    )

    return {
        "Logistic_Regression": {
            "estimator": modelo_logit,
            "scoring": "roc_auc"
        },
        "Random_Forest": {
            "estimator": modelo_rf,
            "scoring": "roc_auc"
        },
        "XGBoost": {
            "estimator": modelo_xgb,
            "scoring": "roc_auc"
        }
    }


# =============================================================================
# 3. CONVERTIR RESULTADOS DE MLXTEND A DATAFRAME
# =============================================================================
def crear_resumen_sfs(sfs: SFS, nombres_features: pd.Index) -> pd.DataFrame:
    """
    Convierte sfs.subsets_ a una tabla entendible.

    En mlxtend, subsets_ guarda un diccionario con una entrada por cada k:
        subsets_[5] = mejor subconjunto de exactamente 5 variables.

    Por eso NO se usa +1 ni -1: la llave k ya es el numero real de variables.
    Tampoco se usa k_score_df_, porque ese atributo no existe en mlxtend 0.25.0.
    """
    filas = []

    for k, info in sfs.subsets_.items():
        indices = info["feature_idx"]
        variables = [nombres_features[i] for i in indices]

        filas.append({
            "k": int(k),
            "auc_mean": float(info["avg_score"]),
            "auc_std": float(info.get("std_dev", np.nan)),
            "features": ", ".join(variables)
        })

    return (
        pd.DataFrame(filas)
        .sort_values("k")
        .reset_index(drop=True)
    )


# =============================================================================
# 4. FORWARD Y BACKWARD PARA UN MODELO
# =============================================================================
def ejecutar_forward_backward(
    X: pd.DataFrame,
    y: pd.Series,
    estimator,
    scoring: str,
    cv: StratifiedKFold,
    k_features: Union[int, Tuple[int, int]],
    n_jobs: int = 1
) -> Dict[str, pd.DataFrame]:
    """Ejecuta forward y backward selection para un estimador."""

    # -------------------------------------------------------------------------
    # FORWARD: empieza desde pocas variables y agrega una a una.
    # -------------------------------------------------------------------------
    sfs_forward = SFS(
        estimator=estimator,
        k_features=k_features,
        forward=True,
        floating=False,
        scoring=scoring,
        cv=cv,
        n_jobs=n_jobs,
        verbose=1
    )

    sfs_forward.fit(X.values, y.values)
    resumen_forward = crear_resumen_sfs(sfs_forward, X.columns)

    # -------------------------------------------------------------------------
    # BACKWARD: empieza desde todas las variables y elimina una a una.
    # -------------------------------------------------------------------------
    sfs_backward = SFS(
        estimator=estimator,
        k_features=k_features,
        forward=False,
        floating=False,
        scoring=scoring,
        cv=cv,
        n_jobs=n_jobs,
        verbose=1
    )

    sfs_backward.fit(X.values, y.values)
    resumen_backward = crear_resumen_sfs(sfs_backward, X.columns)

    return {
        "forward_summary": resumen_forward,
        "backward_summary": resumen_backward
    }


# =============================================================================
# 5. EJECUCION COMPLETA SOBRE TU DATASET
# =============================================================================
def ejecutar_sfs_completo(
    dataset: pd.DataFrame,
    target_col: str = TARGET_COL,
    columnas_a_excluir: List[str] = COLUMNAS_A_EXCLUIR,
    n_folds: int = N_FOLDS,
    k_features: Union[int, Tuple[int, int]] = K_FEATURES,
    output_dir: str = OUTPUT_DIR
) -> Dict[str, Dict[str, pd.DataFrame]]:
    """
    Funcion principal.

    Parametro esperado:
    - dataset: tu DataFrame cargado en el notebook.
    - target_col: 'marca', con valores 0 y 1.

    Devuelve:
    - results, con tablas forward y backward para los tres modelos.
    """
    if target_col not in dataset.columns:
        raise ValueError(
            f"No existe la columna target '{target_col}'. "
            f"Columnas disponibles: {list(dataset.columns[:20])} ..."
        )

    # Seleccion automatica de columnas numericas.
    feature_cols = [
        col for col in dataset.select_dtypes(include=[np.number]).columns
        if col not in columnas_a_excluir
    ]

    if len(feature_cols) < 2:
        raise ValueError("Se requieren al menos dos features numericas para correr SFS.")

    # X: solo variables predictoras; y: target.
    X = dataset[feature_cols].copy()
    y = dataset[target_col].copy()

    # SFS necesita variables sin infinitos y sin valores faltantes.
    X = X.replace([np.inf, -np.inf], np.nan)
    X = X.fillna(X.median(numeric_only=True)).fillna(0)

    # Se eliminan filas sin target y se fuerza target entero binario.
    filas_validas = y.notna()
    X = X.loc[filas_validas].reset_index(drop=True)
    y = y.loc[filas_validas].astype(int).reset_index(drop=True)

    clases = sorted(y.unique())
    if len(clases) != 2:
        raise ValueError(
            f"'{target_col}' debe ser binaria (dos clases). "
            f"Clases encontradas: {clases}"
        )

    conteo_clases = y.value_counts().sort_index()
    min_clase = int(conteo_clases.min())

    if min_clase < n_folds:
        raise ValueError(
            f"La clase minoritaria tiene {min_clase} registros; "
            f"reduce n_folds={n_folds}."
        )

    # Ajusta el rango k si tienes menos columnas que el maximo definido.
    n_features = X.shape[1]
    if isinstance(k_features, tuple):
        min_k, max_k = k_features
        max_k = min(max_k, n_features)
        min_k = min(min_k, max_k)
        k_features_ajustado = (min_k, max_k)
    else:
        k_features_ajustado = min(int(k_features), n_features)

    print("\n" + "=" * 90)
    print("INICIO DE SEQUENTIAL FEATURE SELECTION (FORWARD Y BACKWARD)")
    print("=" * 90)
    print(f"Target: {target_col}")
    print(f"Clases del target: {conteo_clases.to_dict()}")
    print(f"Numero de features candidatas: {n_features}")
    print(f"Rango de features a evaluar: {k_features_ajustado}")
    print(f"Numero de folds: {n_folds}")
    print(f"Estandarizacion en Logit: {USAR_ESTANDARIZACION_LOGIT}")
    print("\nPrimeras 20 features:")
