# =============================================================================
# 3. EVALUACION DE ESTABILIDAD DE RENDIMIENTO
# =============================================================================

def evaluate_performance_stability(
    X: pd.DataFrame,
    y: pd.Series,
    models: Dict[str, dict],
    n_folds: int = 5,
    n_bootstrap: int = 200,
    random_state: int = 42
) -> pd.DataFrame:
    """
    Evalua estabilidad de rendimiento (CV + bootstrap) para todos los modelos.
    """
    cv = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=random_state)
    
    results = []
    
    for name, config in models.items():
        model_class = config["class"]
        params = config["params"]
        
        model = model_class(**params)
        
        # Cross-validation
        cv_scores = cross_val_score(model, X, y, cv=cv, scoring="roc_auc")
        
        # Bootstrap
        model_boot = model_class(**params)
        boot_scores = bootstrap_auc(X, y, model_boot, n_iter=n_bootstrap, random_state=random_state)
        
        results.append({
            "modelo": name,
            "auc_cv_mean": cv_scores.mean(),
            "auc_cv_std": cv_scores.std(),
            "auc_bootstrap_mean": boot_scores.mean(),
            "auc_bootstrap_std": boot_scores.std(),
            "auc_bootstrap_ci_low": np.percentile(boot_scores, 2.5),
            "auc_bootstrap_ci_high": np.percentile(boot_scores, 97.5)
        })
    
    df_results = pd.DataFrame(results)
    return df_results


# =============================================================================
# 4. VALIDACION TEMPORAL
# =============================================================================

def temporal_validation(
    df: pd.DataFrame,
    feature_cols: List[str],
    target_col: str,
    date_col: str,
    models: Dict[str, dict],
    cutoff_val: str,
    cutoff_test: str
) -> pd.DataFrame:
    """
    Validacion temporal: train (antes de cutoff_val),
    val (cutoff_val a cutoff_test), test (despues de cutoff_test).
    """
    df = df.sort_values(date_col)
    
    train = df[df[date_col] < cutoff_val]
    val = df[(df[date_col] >= cutoff_val) & (df[date_col] < cutoff_test)]
    test = df[df[date_col] >= cutoff_test]
    
    X_train, y_train = train[feature_cols], train[target_col]
    X_val, y_val = val[feature_cols], val[target_col]
    X_test, y_test = test[feature_cols], test[target_col]
    
    results = []
    
    for name, config in models.items():
        model_class = config["class"]
        params = config["params"]
        
        model = model_class(**params)
        model.fit(X_train, y_train)
        
        auc_train = roc_auc_score(y_train, model.predict_proba(X_train)[:, 1])
        auc_val = roc_auc_score(y_val, model.predict_proba(X_val)[:, 1])
        auc_test = roc_auc_score(y_test, model.predict_proba(X_test)[:, 1])
        
        results.append({
            "modelo": name,
            "auc_train": auc_train,
            "auc_val": auc_val,
            "auc_test": auc_test,
            "drop_train_val": auc_train - auc_val,
            "drop_val_test": auc_val - auc_test,
            "drop_train_test": auc_train - auc_test
        })
    
    df_results = pd.DataFrame(results)
    return df_results


