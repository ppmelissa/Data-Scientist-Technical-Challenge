# =============================================================================
# 1. FUNCIONES AUXILIARES
# =============================================================================

def compute_psi(expected: np.ndarray, actual: np.ndarray, bins: int = 10) -> float:
    """
    Calcula Population Stability Index (PSI) entre dos distribuciones.
    
    expected: datos de referencia (ej. train)
    actual: datos a comparar (ej. produccion)
    bins: numero de bins para variables continuas
    """
    # Crear bins usando la distribucion de referencia
    breakpoints = np.quantile(expected, np.linspace(0, 1, bins + 1))
    breakpoints = np.unique(breakpoints)
    
    if len(breakpoints) < 2:
        return 0.0
    
    def bin_counts(data: np.ndarray) -> np.ndarray:
        counts = np.histogram(data, bins=breakpoints)[0]
        pct = counts / counts.sum()
        # Evitar ceros
        pct = np.where(pct == 0, 1e-6, pct)
        return pct
    
    exp_pct = bin_counts(expected)
    act_pct = bin_counts(actual)
    
    psi = np.sum((act_pct - exp_pct) * np.log(act_pct / exp_pct))
    return psi


def bootstrap_auc(
    X: pd.DataFrame,
    y: pd.Series,
    model,
    n_iter: int = 200,
    test_size: float = 0.3,
    scoring: str = "roc_auc",
    random_state: int = 42
) -> np.ndarray:
    """
    Bootstrap de rendimiento (AUC u otra metrica).
    """
    rng = np.random.RandomState(random_state)
    scores = []
    
    for i in range(n_iter):
        X_boot, y_boot = resample(X, y, random_state=rng.randint(0, 10000))
        
        # Hold-out interno (out-of-bag aproximado)
        mask = ~np.isin(np.arange(len(X)), X_boot.index)
        if mask.sum() < 20:
            continue
        
        X_oob, y_oob = X.iloc[mask], y.iloc[mask]
        
        model.fit(X_boot, y_boot)
        
        if scoring == "roc_auc":
            pred = model.predict_proba(X_oob)[:, 1]
            score = roc_auc_score(y_oob, pred)
        else:
            score = model.score(X_oob, y_oob)
        
        scores.append(score)
    
    return np.array(scores)


def bootstrap_coefficients_logreg(
    X: pd.DataFrame,
    y: pd.Series,
    n_iter: int = 200,
    random_state: int = 42
) -> pd.DataFrame:
    """
    Bootstrap de coeficientes para regresion logistica.
    """
    rng = np.random.RandomState(random_state)
    coefs = []
    
    for i in range(n_iter):
        X_boot, y_boot = resample(X, y, random_state=rng.randint(0, 10000))
        
        logreg = LogisticRegression(
            max_iter=1000,
            n_jobs=-1,
            random_state=rng.randint(0, 10000)
        )
        logreg.fit(X_boot, y_boot)
        coefs.append(logreg.coef_[0])
    
    coefs = np.array(coefs)  # (n_iter, n_features)
    mean_coefs = coefs.mean(axis=0)
    std_coefs = coefs.std(axis=0)
    
    df_coefs = pd.DataFrame({
        "feature": X.columns,
        "coef_mean": mean_coefs,
        "coef_std": std_coefs,
        "coef_cv": std_coefs / (np.abs(mean_coefs) + 1e-9)
    })
    return df_coefs.sort_values("coef_cv")


def bootstrap_perm_importance(
    X: pd.DataFrame,
    y: pd.Series,
    model_class,
    model_params: dict,
    n_iter: int = 100,
    scoring: str = "roc_auc",
    random_state: int = 42
) -> pd.DataFrame:
    """
    Bootstrap de permutation importance para RF, XGBoost, etc.
    """
    rng = np.random.RandomState(random_state)
    importances_list = []
    
    for i in range(n_iter):
        X_boot, y_boot = resample(X, y, random_state=rng.randint(0, 10000))
        
        model = model_class(**model_params, random_state=rng.randint(0, 10000))
        model.fit(X_boot, y_boot)
        
        # Hold-out interno para permutation importance
        mask = ~np.isin(np.arange(len(X)), X_boot.index)
        if mask.sum() < 50:
            continue
        
        X_oob, y_oob = X.iloc[mask], y.iloc[mask]
        
        pi = permutation_importance(
            model, X_oob, y_oob,
            n_repeats=20,
            scoring=scoring,
            random_state=rng.randint(0, 10000),
            n_jobs=-1
        )
        importances_list.append(pi.importances_mean)
    
    importances_arr = np.array(importances_list)  # (n_iter, n_features)
    mean_imp = importances_arr.mean(axis=0)
    std_imp = importances_arr.std(axis=0)
    
    df_imp = pd.DataFrame({
        "feature": X.columns,
        "importance_mean": mean_imp,
        "importance_std": std_imp,
        "importance_cv": std_imp / (np.abs(mean_imp) + 1e-9)
    })
    return df_imp.sort_values("importance_mean", ascending=False)


