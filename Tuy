"""
Analisis de correlacion y reduccion de variables para modelos RBA / fraude.

Incluye:
1. Correlacion feature-target (Pearson y Spearman).
2. Correlacion feature-feature y pares redundantes.
3. Recomendacion automatica de variable a conservar/eliminar.
4. Calculo de VIF para multicolinealidad en regresion logistica.
5. Exportacion de resultados a CSV.

Requisitos:
    pip install pandas numpy statsmodels
"""

from pathlib import Path
from typing import List, Optional, Tuple

import numpy as np
import pandas as pd
from statsmodels.stats.outliers_influence import variance_inflation_factor


# -----------------------------------------------------------------------------
# 1. Correlacion de cada feature contra el target binario Y
# -----------------------------------------------------------------------------
def feature_target_correlation(
    df: pd.DataFrame,
    feature_cols: List[str],
    target_col: str,
    method: str = "spearman"
) -> pd.DataFrame:
    """
    Calcula correlacion entre cada feature numerica y el target (0/1).

    Para fraude, Spearman suele ser un buen punto de partida porque es robusto
    ante outliers y detecta relaciones monotonicas, no solo lineales.
    """
    data = df[feature_cols + [target_col]].copy()
    correlations = data.corr(method=method)[target_col].drop(target_col)

    result = pd.DataFrame({
        "feature": correlations.index,
        f"corr_{method}_target": correlations.values,
        f"abs_corr_{method}_target": correlations.abs().values,
        "missing_rate": data[feature_cols].isna().mean().reindex(correlations.index).values,
        "n_unique": data[feature_cols].nunique().reindex(correlations.index).values
    })

    return result.sort_values(f"abs_corr_{method}_target", ascending=False).reset_index(drop=True)


# -----------------------------------------------------------------------------
# 2. Correlacion entre features y deteccion de pares redundantes
# -----------------------------------------------------------------------------
def high_correlation_pairs(
    df: pd.DataFrame,
    feature_cols: List[str],
    method: str = "spearman",
    threshold: float = 0.80
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """
    Retorna:
    - Matriz de correlacion entre features.
    - Tabla de pares con |correlacion| >= threshold.
    """
    corr_matrix = df[feature_cols].corr(method=method)
    rows = []

    for i, feature_1 in enumerate(corr_matrix.columns):
        for j in range(i + 1, len(corr_matrix.columns)):
            feature_2 = corr_matrix.columns[j]
            corr_value = corr_matrix.iloc[i, j]

            if pd.notna(corr_value) and abs(corr_value) >= threshold:
                rows.append({
                    "feature_1": feature_1,
                    "feature_2": feature_2,
                    f"corr_{method}": corr_value,
                    f"abs_corr_{method}": abs(corr_value)
                })

    pair_cols = ["feature_1", "feature_2", f"corr_{method}", f"abs_corr_{method}"]
    pairs = pd.DataFrame(rows, columns=pair_cols)

    if not pairs.empty:
        pairs = pairs.sort_values(f"abs_corr_{method}", ascending=False).reset_index(drop=True)

    return corr_matrix, pairs


# -----------------------------------------------------------------------------
# 3. Recomendacion de variable a conservar ante pares correlacionados
# -----------------------------------------------------------------------------
def recommend_feature_pruning(
    corr_target: pd.DataFrame,
    corr_pairs: pd.DataFrame,
    method_target: str = "spearman"
) -> pd.DataFrame:
    """
    Para cada par muy correlacionado, recomienda conservar la feature con mayor
    correlacion absoluta con Y. Si empatan, conserva la de menor missing rate.

    Importante: esta es una recomendacion automatica; valida siempre sentido de
    negocio, leakage, disponibilidad en tiempo real y estabilidad temporal.
    """
    target_col_abs = f"abs_corr_{method_target}_target"
    target_lookup = corr_target.set_index("feature")[[target_col_abs, "missing_rate", "n_unique"]]

    recommendations = []

    for _, row in corr_pairs.iterrows():
        f1, f2 = row["feature_1"], row["feature_2"]
        f1_target = target_lookup.loc[f1, target_col_abs]
        f2_target = target_lookup.loc[f2, target_col_abs]
        f1_missing = target_lookup.loc[f1, "missing_rate"]
        f2_missing = target_lookup.loc[f2, "missing_rate"]

        if f1_target > f2_target:
            keep, drop, reason = f1, f2, "Mayor correlacion absoluta con target"
        elif f2_target > f1_target:
            keep, drop, reason = f2, f1, "Mayor correlacion absoluta con target"
        elif f1_missing < f2_missing:
            keep, drop, reason = f1, f2, "Empate con target; menor porcentaje de nulos"
        elif f2_missing < f1_missing:
            keep, drop, reason = f2, f1, "Empate con target; menor porcentaje de nulos"
        else:
            keep, drop, reason = f1, f2, "Empate; decision pendiente de criterio de negocio"

        recommendations.append({
            "feature_1": f1,
            "feature_2": f2,
            "keep_recommended": keep,
            "drop_candidate": drop,
            "reason": reason,
            f"abs_corr_{method_target}_target_feature_1": f1_target,
            f"abs_corr_{method_target}_target_feature_2": f2_target,
            "missing_rate_feature_1": f1_missing,
            "missing_rate_feature_2": f2_missing,
            "correlation_between_features": row.iloc[-2]
        })

    return pd.DataFrame(recommendations)


# -----------------------------------------------------------------------------
# 4. VIF: diagnostico adicional de multicolinealidad para regresion logistica
# -----------------------------------------------------------------------------
def calculate_vif(
    df: pd.DataFrame,
    feature_cols: List[str],
    max_rows: Optional[int] = 100_000
) -> pd.DataFrame:
    """
    Calcula VIF por feature. El VIF requiere variables numericas sin NA.

    Guia orientativa:
    - VIF < 5: sin alerta relevante.
    - 5 <= VIF < 10: multicolinealidad moderada; revisar.
    - VIF >= 10: multicolinealidad alta; intervenir o justificar.
    """
    X = df[feature_cols].replace([np.inf, -np.inf], np.nan).dropna().copy()

    if max_rows is not None and len(X) > max_rows:
        X = X.sample(max_rows, random_state=42)

    # Quitar columnas constantes: el VIF no se puede calcular correctamente.
    usable_cols = X.columns[X.nunique() > 1].tolist()
    X = X[usable_cols]

    if X.shape[1] < 2:
        return pd.DataFrame(columns=["feature", "vif", "vif_status"])

    rows = []
    values = X.astype(float).values

    for idx, feature in enumerate(X.columns):
        try:
            vif = variance_inflation_factor(values, idx)
        except Exception:
            vif = np.inf

        if vif < 5:
            status = "Sin alerta"
        elif vif < 10:
            status = "Moderado"
        else:
            status = "Alto"

        rows.append({"feature": feature, "vif": vif, "vif_status": status})

    return pd.DataFrame(rows).sort_values("vif", ascending=False).reset_index(drop=True)


# -----------------------------------------------------------------------------
# 5. Funcion principal y exportacion
# -----------------------------------------------------------------------------
def run_correlation_analysis(
    df: pd.DataFrame,
    feature_cols: List[str],
    target_col: str,
    correlation_method: str = "spearman",
    pair_threshold: float = 0.80,
    run_vif: bool = True,
    output_dir: Optional[str] = "output_correlacion"
) -> dict:
    """
    Ejecuta el analisis completo y, opcionalmente, guarda resultados a CSV.

    Retorna un diccionario con:
    - corr_target: ranking X vs Y.
    - corr_matrix: matriz X vs X.
    - high_corr_pairs: pares con correlacion alta.
    - recommendations: sugerencia automatica de poda.
    - vif: VIF para regresion logistica.
    """
    missing_features = sorted(set(feature_cols) - set(df.columns))
    if missing_features:
        raise ValueError(f"Features no encontradas en df: {missing_features}")
    if target_col not in df.columns:
        raise ValueError(f"Target no encontrado en df: {target_col}")

    if correlation_method not in {"pearson", "spearman"}:
        raise ValueError("correlation_method debe ser 'pearson' o 'spearman'.")

    # Se excluyen features no numericas; encodea categoricas antes si las necesitas.
    numeric_features = df[feature_cols].select_dtypes(include=np.number).columns.tolist()
    excluded_features = sorted(set(feature_cols) - set(numeric_features))

    if not numeric_features:
        raise ValueError("No hay features numericas para calcular correlaciones.")

    corr_target = feature_target_correlation(
        df=df,
        feature_cols=numeric_features,
        target_col=target_col,
        method=correlation_method
    )

    corr_matrix, corr_pairs = high_correlation_pairs(
        df=df,
        feature_cols=numeric_features,
        method=correlation_method,
        threshold=pair_threshold
    )

    recommendations = recommend_feature_pruning(
        corr_target=corr_target,
        corr_pairs=corr_pairs,
        method_target=correlation_method
    )

    vif = calculate_vif(df, numeric_features) if run_vif else pd.DataFrame()

    results = {
        "corr_target": corr_target,
        "corr_matrix": corr_matrix,
        "high_corr_pairs": corr_pairs,
        "recommendations": recommendations,
        "vif": vif,
        "excluded_non_numeric_features": pd.DataFrame({"feature": excluded_features})
    }

    if output_dir is not None:
        output_path = Path(output_dir)
        output_path.mkdir(parents=True, exist_ok=True)

        corr_target.to_csv(output_path / "01_correlacion_feature_target.csv", index=False)
        corr_matrix.to_csv(output_path / "02_matriz_correlacion_features.csv")
        corr_pairs.to_csv(output_path / "03_pares_alta_correlacion.csv", index=False)
        recommendations.to_csv(output_path / "04_recomendaciones_poda.csv", index=False)
